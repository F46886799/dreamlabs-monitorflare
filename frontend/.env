# =========================================
# MonitorFlare 前端环境变量示例
# 复制为 .env 后填入你的真实值
# =========================================

# Cloudflare Web Analytics（留空则不注入统计脚本）
VITE_CF_ANALYTICS_TOKEN=

# 站点页脚作者信息
VITE_FOOTER_AUTHOR=Dreamlabs MonitorFlare
VITE_FOOTER_URL=https://github.com/F46886799/dreamlabs-monitorflare

# 本地开发时后端 Worker 地址（可选，默认 http://127.0.0.1:8787）
VITE_WORKER_URL=https://monitorflare-worker.f-46886799.workers.dev
